# Textos com fim de linha normalizado; arquivos binários nunca são alterados
* text=auto
*.bat text eol=crlf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.xlsx binary
*.db binary
*.zip binary
*.bundle binary
