# Copie este arquivo para ".env" e ajuste o que precisar.

# --- IA (opcional) -----------------------------------------------------------
# Com a chave preenchida, aparece o botão "Analisar com IA" para fotos difíceis.
# Crie a chave em https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Modelo usado na análise
LEITOR_IA_MODELO=claude-opus-5
# 1 = chama a IA automaticamente quando a leitura local tiver baixa confiança
LEITOR_IA_AUTOMATICA=0

# --- Notificações ------------------------------------------------------------
# Canais, horário e antecedência são configurados na tela "Notificações".
# 0 = desliga o agendador automático de avisos neste computador
LEITOR_NOTIFICACOES_AUTOMATICAS=1
# Endereço usado nos links das notificações (padrão: http://localhost:PORTA)
# LEITOR_URL=

# --- Servidor ----------------------------------------------------------------
# Use 0.0.0.0 para acessar pelo celular na mesma rede Wi-Fi (http://IP-DO-PC:8000)
LEITOR_HOST=127.0.0.1
# Senha pedida para acessos vindos de outros aparelhos da rede (recomendado com LEITOR_HOST=0.0.0.0).
# No próprio computador o acesso continua livre.
LEITOR_SENHA_ACESSO=
LEITOR_PORT=8000
LEITOR_ABRIR_NAVEGADOR=1

# --- VPS / EasyPanel ---------------------------------------------------------
# LEITOR_HOST=0.0.0.0
# LEITOR_ABRIR_NAVEGADOR=0
# LEITOR_DADOS_DIR=/app/dados
# LEITOR_URL=https://fin.seudominio.com.br
# TZ=America/Sao_Paulo

# --- Dados -------------------------------------------------------------------
# Pasta dos dados (planilha, arquivos enviados e backups). Padrão: ./dados
# LEITOR_DADOS_DIR=C:\Users\voce\OneDrive\Boletos
# Caminho da planilha. Padrão: <pasta de dados>\boletos.xlsx
# LEITOR_PLANILHA=
LEITOR_MAX_UPLOAD_MB=100
LEITOR_MAX_PAGINAS_PDF=30
# Arquivos enviados e nunca lançados são apagados após N dias
LEITOR_DIAS_ARQUIVOS_TEMP=2
